---
import '../styles/global.css';
import Countdown from '../components/Countdown.astro';
import MarFondo from '../components/MarFondo.astro';
import SonidoMar from '../components/SonidoMar.astro';
import { evento } from '../lib/config';

// Base del sitio (para GitHub Pages: /marea). Sin barra final para concatenar rutas.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Genera el link de WhatsApp con mensaje prellenado
const waLink = (numero: string, mensaje: string) =>
  `https://wa.me/${numero}?text=${encodeURIComponent(mensaje)}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1f1f1f" />
    <title>{evento.titulo} · {evento.subtitulo}</title>
    <meta
      name="description"
      content={`${evento.titulo} de ${evento.subtitulo} — ${evento.fechaTexto}, ${evento.lugar.direccion}.`}
    />
    <meta property="og:title" content={`${evento.titulo} · ${evento.subtitulo}`} />
    <meta property="og:description" content={evento.descripcion} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="inv2">
    <MarFondo />
    <div class="glass-shell">
    <main class="wrap glass-panel">
      <SonidoMar inline />
      <!-- ── HERO ──────────────────────────────────────────── -->
      <header class="hero">
        <div class="hero__main">
          <div class="hero__logo-wrap">
            <img class="hero__logo reveal" src={`${base}/logo-marea.png`} alt="Marea Business" width="720" height="405" />
          </div>

          <p class="descripcion serif reveal" set:html={evento.descripcion}></p>
        </div>

        <div class="hero__foot reveal">
          <div class="hero__logos">
            <img class="logo-mecol" src={`${base}/logos/mecol-blanco.png`} alt="Mecol Estudio" loading="lazy" />
            <span class="hero__logos-div"></span>
            <img class="logo-caetano" src={`${base}/logos/caetano-blanco.png`} alt="Caetano Negocios Inmobiliarios" loading="lazy" />
          </div>

          <a class="hero__scroll" href="#evento" aria-label="Deslizá hacia abajo">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </a>
        </div>
      </header>

      <!-- ── EVENTO (segundo bloque) ───────────────────────── -->
      <section id="evento" class="bloque bloque--evento reveal">
        <div class="filete"><span class="filete__rombo"></span></div>
        <h1 class="hero__titulo">{evento.titulo}</h1>
        {evento.tituloDetalle && <p class="hero__detalle serif">{evento.tituloDetalle}</p>}
        <p class="hero__fecha">
          <span class="dorado">{evento.fechaTexto}</span>
          <span class="hero__hora">{evento.horaTexto}</span>
        </p>
      </section>

      <!-- ── COUNTDOWN ─────────────────────────────────────── -->
      <section id="faltan" class="bloque reveal" aria-labelledby="cd-title">
        <p id="cd-title" class="bloque__eyebrow">Faltan</p>
        <Countdown fechaISO={evento.fechaISO} />
      </section>

      <!-- ── LUGAR ─────────────────────────────────────────── -->
      <section class="bloque reveal" aria-labelledby="lugar-title">
        <div class="filete"><span class="filete__rombo"></span></div>
        <h2 id="lugar-title" class="seccion__titulo">¿Dónde?</h2>
        <p class="lugar__dir">{evento.lugar.direccion}</p>
        {
          evento.dressCode && (
            <p class="lugar__dress">
              <span class="kicker">Dress code</span>
              <span class="serif dorado">{evento.dressCode}</span>
            </p>
          )
        }
        {
          evento.lugar.mapsUrl && (
            <a class="btn btn--ghost" href={evento.lugar.mapsUrl} target="_blank" rel="noopener">
              Ver ubicación
            </a>
          )
        }
      </section>

      <!-- ── RSVP WHATSAPP ─────────────────────────────────── -->
      <section class="bloque bloque--rsvp reveal" aria-labelledby="rsvp-title">
        <div class="filete"><span class="filete__rombo"></span></div>
        <h2 id="rsvp-title" class="seccion__titulo">{evento.rsvp.titulo}</h2>
        <p class="seccion__sub">{evento.rsvp.subtitulo}</p>
        <div class="rsvp-botones">
          {
            evento.rsvp.contactos.map((c) => (
              <a
                class="btn-rsvp"
                href={waLink(c.numero, c.mensaje)}
                target="_blank"
                rel="noopener"
                aria-label={`Confirmar asistencia con ${c.nombre}`}
              >
                <svg class="btn-rsvp__wa" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor">
                  <path d="M17.5 14.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35zM12.05 21.5h-.01a9.5 9.5 0 0 1-4.84-1.33l-.35-.2-3.6.94.96-3.5-.23-.36a9.46 9.46 0 0 1-1.45-5.05c0-5.23 4.26-9.49 9.5-9.49 2.54 0 4.92.99 6.72 2.78a9.42 9.42 0 0 1 2.78 6.72c0 5.24-4.26 9.5-9.49 9.5zm8.08-17.58A11.4 11.4 0 0 0 12.04.5C5.76.5.65 5.61.65 11.89c0 2.02.53 3.99 1.53 5.73L.5 23.5l6.02-1.58a11.34 11.34 0 0 0 5.52 1.41h.01c6.28 0 11.39-5.11 11.39-11.39 0-3.04-1.18-5.9-3.33-8.05z" />
                </svg>
                <img class={`btn-rsvp__logo ${c.nombre.includes('Mecol') ? 'is-mecol' : ''}`} src={`${base}${c.logo}`} alt={c.nombre} loading="lazy" />
              </a>
            ))
          }
        </div>
      </section>

      <!-- ── FOOTER ────────────────────────────────────────── -->
      <footer class="pie reveal">
        <img class="pie__logo" src={`${base}/logo-marea.png`} alt="Marea Group" width="720" height="405" />
        <p class="pie__firma">Punta del Este</p>
      </footer>
    </main>
    </div>

    <script>
      // Reveal on scroll — respeta prefers-reduced-motion vía CSS.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>

    <style>
      /* ═══ INVITACIÓN 2 · TARJETA GLASS SOBRE EL MAR ══════════ */
      /* El MarFondo (fixed) es el telón; el contenido va en un panel glass
         con margen en los laterales y abajo, dejando ver el mar por detrás. */
      .glass-shell {
        position: relative;
        z-index: 1;
        min-height: 100dvh;
        padding: clamp(14px, 4vw, 26px);
        padding-bottom: clamp(24px, 7vw, 48px);
        display: flex;
        flex-direction: column;
      }

      .glass-panel {
        position: relative;
        z-index: 1;
        width: min(560px, 100%);
        margin-inline: auto;
        margin-block: clamp(14px, 4vw, 26px);
        padding-inline: clamp(22px, 6vw, 40px);
        border-radius: clamp(22px, 6vw, 36px);
        background: rgba(24, 29, 27, 0.30);
        -webkit-backdrop-filter: blur(6px) saturate(1.3);
        backdrop-filter: blur(6px) saturate(1.3);
        border: 1px solid rgba(245, 243, 238, 0.18);
        box-shadow:
          0 34px 90px -34px rgba(0, 0, 0, 0.78),
          inset 0 1px 0 rgba(255, 255, 255, 0.18);
        overflow: hidden;
      }
      /* Reflejo tipo vidrio en el borde superior */
      .glass-panel::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        pointer-events: none;
        background: linear-gradient(157deg, rgba(255, 255, 255, 0.13), transparent 34%);
      }
      /* Filete dorado interior muy sutil */
      .glass-panel::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        pointer-events: none;
        box-shadow: inset 0 0 0 1px rgba(199, 164, 106, 0.14);
      }

      /* El hero deja de ocupar toda la pantalla: fluye dentro de la tarjeta */
      .glass-panel .hero {
        min-height: auto;
        padding-block: clamp(2.2rem, 7vw, 3.4rem) clamp(1.4rem, 5vw, 2.4rem);
      }
      .glass-panel .hero__main { justify-content: flex-start; }
      /* El pie sin borde duro (queda dentro del vidrio) */
      .glass-panel .pie { border-top: 1px solid var(--linea); }

      /* ── HERO ──────────────────────────────────────────── */
      .hero {
        position: relative;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        text-align: center;
        padding-block: clamp(2rem, 5vh, 3.2rem);
      }
      .hero__main {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: clamp(1.4rem, 5vw, 2rem);
        width: 100%;
      }
      .hero__foot {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: clamp(1.3rem, 4vh, 2rem);
        padding-top: clamp(1.2rem, 4vh, 2rem);
      }
      .hero__logos {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: clamp(1.1rem, 5vw, 2rem);
      }
      .hero__logos img {
        height: clamp(26px, 8vw, 42px);
        width: auto;
        opacity: 0.9;
      }
      .hero__logos img.logo-mecol {
        height: 25px;
      }
      .hero__logos-div {
        width: 1px;
        height: clamp(30px, 8vw, 42px);
        background: var(--linea);
      }
      .hero__logo-wrap {
        display: flex;
        justify-content: center;
        margin-bottom: clamp(0.6rem, 3vw, 1.2rem);
      }
      .hero__logo {
        width: clamp(150px, 46vw, 210px);
        height: auto;
        /* Logo en negro → blanco marfil sobre el fondo carbón (versión negativa del manual) */
        filter: brightness(0) invert(1);
        opacity: 0.95;
      }
      .hero__titulo {
        font-family: var(--serif);
        font-style: italic;
        font-weight: 400;
        font-size: clamp(2.6rem, 13vw, 4.4rem);
        line-height: 1.02;
        margin: 0;
        color: var(--marfil);
      }
      /* Margen superior para equilibrar el bloque del evento (simetría con el espacio de abajo) */
      .bloque--evento .hero__titulo {
        margin-top: clamp(2.2rem, 6vh, 3.2rem);
      }
      /* Misma simetría para el bloque "¿Dónde?" */
      [aria-labelledby="lugar-title"] .seccion__titulo {
        margin-top: clamp(3.4rem, 9vh, 4.7rem);
      }
      .hero__detalle {
        font-style: italic;
        font-size: clamp(1rem, 4.6vw, 1.35rem);
        color: var(--piedra);
        margin: 0;
      }
      .hero__scroll {
        display: flex;
        justify-content: center;
        color: var(--champagne);
        opacity: 0.85;
        transition: opacity 0.25s ease;
      }
      .hero__scroll:hover { opacity: 1; }
      .hero__scroll svg {
        animation: flechaBaja 1.8s ease-in-out infinite;
      }
      @keyframes flechaBaja {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(9px); }
      }
      @media (prefers-reduced-motion: reduce) {
        .hero__scroll svg { animation: none; }
      }
      .hero__fecha {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--sans);
        font-weight: 300;
        font-size: clamp(0.95rem, 4.2vw, 1.2rem);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin: 0;
        color: var(--piedra);
      }
      .hero__hora {
        font-size: 0.86em;
        letter-spacing: 0.2em;
        color: var(--piedra);
      }
      .hero__punto { margin-inline: 0.5em; color: var(--champagne); }

      /* ── SEGUNDO BLOQUE: EVENTO ────────────────────────── */
      .bloque--evento {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: clamp(1.2rem, 4vw, 1.8rem);
      }

      /* ── BLOQUES GENÉRICOS ─────────────────────────────── */
      .bloque {
        padding-block: clamp(1.6rem, 4.5vh, 2.8rem);
        text-align: center;
      }
      /* Countdown más compacto */
      #faltan {
        padding-block: clamp(1.3rem, 4vh, 2.2rem);
      }
      .bloque__eyebrow {
        font-family: var(--sans);
        font-weight: 300;
        font-size: 0.72rem;
        letter-spacing: 0.4em;
        text-indent: 0.4em;
        text-transform: uppercase;
        color: var(--piedra);
        margin: 0 0 1rem;
      }
      .seccion__titulo {
        font-family: var(--serif);
        font-weight: 500;
        font-size: clamp(1.7rem, 8vw, 2.4rem);
        margin: 1.4rem 0 0.4rem;
        color: var(--marfil);
      }
      .seccion__sub {
        font-family: var(--sans);
        font-weight: 300;
        font-size: clamp(0.85rem, 3.6vw, 0.98rem);
        letter-spacing: 0.04em;
        color: var(--piedra);
        margin: 0 auto 2rem;
        max-width: 34ch;
      }
      .descripcion {
        font-size: clamp(1.15rem, 5vw, 1.5rem);
        font-weight: 400;
        line-height: 1.6;
        color: var(--marfil);
        margin: 0 auto;
        max-width: 33ch;
      }
      .descripcion strong {
        font-weight: 600;
        color: #ffffff;
      }

      /* ── NEGOCIOS ──────────────────────────────────────── */
      .negocios {
        list-style: none;
        margin: 0 auto;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: clamp(0.8rem, 3vw, 1.2rem);
        max-width: 460px;
      }
      .negocio {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        padding: clamp(1.1rem, 5vw, 1.6rem) 0.8rem;
        border: 1px solid var(--linea);
        border-radius: 6px;
        background: linear-gradient(180deg, rgba(245, 243, 238, 0.035), transparent);
      }
      .negocio__logo {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: clamp(52px, 16vw, 72px);
      }
      .negocio__logo img {
        max-height: 100%;
        width: auto;
        object-fit: contain;
        /* Muchos logos vienen en negro; sobre fondo oscuro los invertimos suavemente.
           Si tu logo ya es claro, quitá el filtro editando esta regla. */
        filter: brightness(0) invert(1) opacity(0.92);
      }
      .negocio__ph {
        font-family: var(--serif);
        font-style: italic;
        font-size: clamp(1.1rem, 5vw, 1.4rem);
        color: var(--champagne);
        text-align: center;
        line-height: 1.15;
      }
      .negocio__nombre {
        font-family: var(--sans);
        font-weight: 400;
        font-size: clamp(0.82rem, 3.6vw, 0.95rem);
        letter-spacing: 0.08em;
        color: var(--marfil);
        margin: 0.4rem 0 0;
      }
      .negocio__rubro {
        font-family: var(--sans);
        font-weight: 300;
        font-size: clamp(0.68rem, 3vw, 0.78rem);
        letter-spacing: 0.02em;
        color: var(--piedra);
        margin: 0;
      }

      /* ── LUGAR ─────────────────────────────────────────── */
      .lugar__nombre {
        font-size: clamp(1.5rem, 7vw, 2rem);
        font-weight: 500;
        color: var(--marfil);
        margin: 1.2rem 0 0.3rem;
      }
      .lugar__dir {
        font-family: var(--sans);
        font-weight: 300;
        letter-spacing: 0.05em;
        color: var(--piedra);
        margin: 0 0 1.6rem;
      }
      .lugar__dress {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        align-items: center;
        margin: 0 0 1.8rem;
      }
      .lugar__dress .serif { font-size: 1.3rem; }

      /* ── BOTONES ───────────────────────────────────────── */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        font-family: var(--sans);
        font-weight: 400;
        font-size: clamp(0.9rem, 4vw, 1rem);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        padding: clamp(0.85rem, 4vw, 1.05rem) clamp(1.6rem, 8vw, 2.4rem);
        border-radius: 999px;
        transition: transform 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
        cursor: pointer;
      }
      .btn:active { transform: scale(0.97); }
      .btn--ghost {
        border: 1px solid var(--linea-dorada);
        color: var(--champagne);
      }
      .btn--ghost:hover { background: rgba(199, 164, 106, 0.08); }
      .btn--wa {
        border: none;
        color: var(--carbon);
        background: linear-gradient(135deg, var(--champagne), #dcc08c);
        box-shadow: 0 10px 30px -10px rgba(199, 164, 106, 0.6);
        font-weight: 500;
      }
      .btn--wa:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 38px -12px rgba(199, 164, 106, 0.7);
      }
      .bloque--rsvp { padding-bottom: clamp(3rem, 12vh, 5rem); }

      /* ── BOTONES RSVP (dos estudios, logo adentro) ─────── */
      .rsvp-botones {
        display: flex;
        flex-direction: column;
        gap: clamp(0.8rem, 3vw, 1.1rem);
        max-width: 340px;
        margin: 0 auto;
      }
      .btn-rsvp {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.9rem;
        padding: clamp(0.95rem, 4vw, 1.15rem) 1.4rem;
        border: 1px solid var(--linea-dorada);
        border-radius: 999px;
        background: rgba(199, 164, 106, 0.05);
        transition: background 0.25s ease, border-color 0.25s ease, transform 0.2s ease;
      }
      .btn-rsvp:hover {
        background: rgba(199, 164, 106, 0.12);
        border-color: var(--champagne);
      }
      .btn-rsvp:active { transform: scale(0.98); }
      .btn-rsvp__wa {
        color: var(--champagne);
        flex: none;
      }
      .btn-rsvp__logo {
        height: clamp(24px, 6.4vw, 30px);
        width: auto;
        opacity: 0.95;
      }
      /* Mecol se ve más grande de origen; lo bajo para emparejar con Caetano */
      .btn-rsvp__logo.is-mecol {
        height: clamp(18px, 5vw, 23px);
      }

      /* ── PIE ───────────────────────────────────────────── */
      .pie {
        text-align: center;
        padding-block: clamp(2.5rem, 8vh, 4rem);
        border-top: 1px solid var(--linea);
      }
      .pie__logo {
        width: clamp(120px, 34vw, 160px);
        height: auto;
        margin-inline: auto;
        /* Logo en negro → blanco marfil sobre el fondo carbón */
        filter: brightness(0) invert(1);
        opacity: 0.9;
      }
      .pie__firma {
        margin-top: 1.2rem;
        font-family: var(--sans);
        font-weight: 300;
        font-size: 0.74rem;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--piedra);
      }

    </style>
  </body>
</html>
