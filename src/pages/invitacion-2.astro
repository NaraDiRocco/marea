---
// La invitación glass+video pasó a vivir en /invitacion (URL principal).
// Esta ruta se conserva sólo para redirigir los enlaces ya compartidos.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const destino = `${base}/invitacion`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${destino}`} />
    <link rel="canonical" href={destino} />
    <meta name="robots" content="noindex" />
    <title>MAREA Group · Inauguración</title>
  </head>
  <body>
    <a href={destino}>Ir a la invitación</a>
  </body>
</html>
