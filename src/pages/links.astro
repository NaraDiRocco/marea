---
import '../styles/global.css';

// Base del sitio (para GitHub Pages: /marea). Sin barra final para concatenar rutas.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const mensaje = '¡Hola! Los contacto por Marea.';
const waLink = (numero: string) => `https://wa.me/${numero}?text=${encodeURIComponent(mensaje)}`;

const mapsQuery = 'Edificio+Gala+Puerto,+Calle+10+y+11,+Punta+del+Este';
const mapsUrl = `https://maps.google.com/?q=${mapsQuery}`;
const mapsEmbed = `https://www.google.com/maps?q=${mapsQuery}&output=embed`;

const links = [
  {
    href: `${base}/invitacion/`,
    label: 'Invitación',
    sub: 'Inauguración',
    external: false,
    icon: 'calendario',
  },
  {
    href: waLink('59899759109'),
    label: 'WhatsApp',
    sub: 'Mecol Estudio',
    external: true,
    icon: 'whatsapp',
  },
  {
    href: waLink('59895559230'),
    label: 'WhatsApp',
    sub: 'Inmobiliaria Caetano',
    external: true,
    icon: 'whatsapp',
  },
  {
    href: mapsUrl,
    label: 'Cómo llegar',
    sub: 'Edificio Gala Puerto',
    external: true,
    icon: 'pin',
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1f1f1f" />
    <title>Marea · Links</title>
    <meta
      name="description"
      content="Marea Group — Mecol Estudio e Inmobiliaria Caetano. Todos los enlaces en un solo lugar."
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <main class="wrap links">
      <!-- ── LOGO ──────────────────────────────────────────── -->
      <header class="links__hero reveal">
        <img class="links__logo" src={`${base}/logo-marea.png`} alt="Marea Group" width="720" height="405" />
        <p class="links__bajada serif">
          Un punto de encuentro profesional en Punta del Este.
          <br />
          Mecol Estudio e Inmobiliaria Caetano, juntos bajo Marea.
        </p>
      </header>

      <div class="filete reveal"><span class="filete__rombo"></span></div>

      <!-- ── BOTONES ───────────────────────────────────────── -->
      <nav class="links__botones reveal" aria-label="Enlaces">
        {
          links.map((l) => (
            <a
              class="btn-link"
              href={l.href}
              target={l.external ? '_blank' : undefined}
              rel={l.external ? 'noopener' : undefined}
            >
              <span class="btn-link__icon" aria-hidden="true">
                {l.icon === 'whatsapp' && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                    <path d="M17.5 14.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35zM12.05 21.5h-.01a9.5 9.5 0 0 1-4.84-1.33l-.35-.2-3.6.94.96-3.5-.23-.36a9.46 9.46 0 0 1-1.45-5.05c0-5.23 4.26-9.49 9.5-9.49 2.54 0 4.92.99 6.72 2.78a9.42 9.42 0 0 1 2.78 6.72c0 5.24-4.26 9.5-9.49 9.5zm8.08-17.58A11.4 11.4 0 0 0 12.04.5C5.76.5.65 5.61.65 11.89c0 2.02.53 3.99 1.53 5.73L.5 23.5l6.02-1.58a11.34 11.34 0 0 0 5.52 1.41h.01c6.28 0 11.39-5.11 11.39-11.39 0-3.04-1.18-5.9-3.33-8.05z" />
                  </svg>
                )}
                {l.icon === 'calendario' && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3.5" y="5" width="17" height="15.5" rx="1.6" />
                    <path d="M3.5 9.5h17" />
                    <path d="M8 3v3.4M16 3v3.4" />
                  </svg>
                )}
                {l.icon === 'pin' && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 21.5s7-6.6 7-12.2A7 7 0 0 0 5 9.3c0 5.6 7 12.2 7 12.2z" />
                    <circle cx="12" cy="9.3" r="2.4" />
                  </svg>
                )}
              </span>
              <span class="btn-link__texto">
                <span class="btn-link__label">{l.label}</span>
                <span class="btn-link__sub">{l.sub}</span>
              </span>
            </a>
          ))
        }
      </nav>

      <!-- ── MAPA ──────────────────────────────────────────── -->
      <section class="links__mapa reveal" aria-label="Mapa de ubicación">
        <iframe
          src={mapsEmbed}
          title="Ubicación"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </section>

      <!-- ── FOOTER ────────────────────────────────────────── -->
      <footer class="pie reveal">
        <div class="marca marca--sm">
          <div class="marca__nombre">Marea</div>
          <div class="marca__business">Group</div>
        </div>
        <p class="pie__firma">Punta del Este</p>
      </footer>
    </main>

    <script>
      // Reveal on scroll — respeta prefers-reduced-motion vía CSS.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>

    <style>
      .links {
        max-width: 420px;
        padding-block: clamp(2.4rem, 8vh, 3.6rem) clamp(1rem, 4vh, 2rem);
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      /* ── HERO ──────────────────────────────────────────── */
      .links__hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: clamp(1.1rem, 4vw, 1.5rem);
        width: 100%;
      }
      .links__logo {
        width: clamp(150px, 46vw, 200px);
        height: auto;
        /* Logo en negro → blanco marfil sobre el fondo carbón */
        filter: brightness(0) invert(1);
        opacity: 0.95;
      }
      .links__bajada {
        font-size: clamp(1rem, 4.4vw, 1.2rem);
        font-weight: 400;
        line-height: 1.6;
        color: var(--marfil);
        margin: 0;
        max-width: 30ch;
      }

      .filete {
        margin-block: clamp(1.6rem, 6vh, 2.4rem);
      }

      /* ── BOTONES ───────────────────────────────────────── */
      .links__botones {
        display: flex;
        flex-direction: column;
        gap: clamp(0.8rem, 3vw, 1rem);
        width: 100%;
      }
      .btn-link {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        width: 100%;
        padding: clamp(0.95rem, 4vw, 1.15rem) clamp(1.2rem, 5vw, 1.5rem);
        border: 1px solid var(--linea-dorada);
        border-radius: 999px;
        background: rgba(199, 164, 106, 0.05);
        color: var(--marfil);
        transition: background 0.25s ease, border-color 0.25s ease, transform 0.2s ease;
      }
      .btn-link:hover {
        background: rgba(199, 164, 106, 0.12);
        border-color: var(--champagne);
      }
      .btn-link:active { transform: scale(0.98); }
      .btn-link__icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: none;
        color: var(--champagne);
      }
      .btn-link__texto {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        text-align: left;
      }
      .btn-link__label {
        font-family: var(--sans);
        font-weight: 400;
        font-size: clamp(0.88rem, 3.8vw, 1rem);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--marfil);
      }
      .btn-link__sub {
        font-family: var(--serif);
        font-style: italic;
        font-size: clamp(0.82rem, 3.4vw, 0.92rem);
        color: var(--piedra);
      }

      /* ── MAPA ──────────────────────────────────────────── */
      .links__mapa {
        width: 100%;
        margin-top: clamp(1.8rem, 6vh, 2.6rem);
        border: 1px solid var(--linea);
        border-radius: 8px;
        overflow: hidden;
        line-height: 0;
      }
      .links__mapa iframe {
        width: 100%;
        height: 200px;
        border: 0;
        display: block;
        filter: grayscale(0.25) contrast(1.05);
      }

      /* ── PIE ───────────────────────────────────────────── */
      .pie {
        text-align: center;
        padding-block: clamp(2.2rem, 8vh, 3.4rem) clamp(0.6rem, 2vh, 1rem);
        margin-top: clamp(1.4rem, 5vh, 2rem);
        border-top: 1px solid var(--linea);
        width: 100%;
      }
      .marca--sm .marca__nombre { font-size: clamp(1.7rem, 8vw, 2.1rem); }
      .marca--sm .marca__business { font-size: 0.58rem; }
      .pie__firma {
        margin-top: 1rem;
        font-family: var(--sans);
        font-weight: 300;
        font-size: 0.72rem;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--piedra);
      }
    </style>
  </body>
</html>
