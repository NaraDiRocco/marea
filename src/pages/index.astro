---
// Raíz del sitio: redirige a la invitación. `base` resuelve solo según la
// configuración (raíz de dominio en Hostinger → cadena vacía).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const destino = `${base}/invitacion`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${destino}`} />
    <link rel="canonical" href={destino} />
    <meta name="robots" content="noindex" />
    <title>Marea</title>
  </head>
  <body>
    <a href={destino}>Ir a la invitación</a>
  </body>
</html>
