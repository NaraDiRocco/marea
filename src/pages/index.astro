---
import '../styles/global.css';
import MarFondo from '../components/MarFondo.astro';
import SonidoMar from '../components/SonidoMar.astro';
import {
  marca,
  nav,
  credenciales,
  valores,
  imagenQueEs,
  marcas,
  beneficios,
  puntaDelEste,
  equipo,
  lugar,
  contacto,
  inauguracion,
  footer,
  seo,
} from '../lib/home';

// Base del sitio (para GitHub Pages: /marea). Sin barra final para concatenar rutas.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Genera el link de WhatsApp con mensaje prellenado
const waLink = (numero: string, mensaje: string) =>
  `https://wa.me/${numero}?text=${encodeURIComponent(mensaje)}`;

// ── Metadata para compartir (WhatsApp / redes) ──
const ogImage = new URL('/og-marea.jpg', Astro.site).href;
const pageUrl = new URL('/', Astro.site).href;

const anio = new Date().getFullYear();

// Ícono de WhatsApp reutilizado en varios botones.
const iconoWa =
  '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M17.5 14.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35zM12.05 21.5h-.01a9.5 9.5 0 0 1-4.84-1.33l-.35-.2-3.6.94.96-3.5-.23-.36a9.46 9.46 0 0 1-1.45-5.05c0-5.23 4.26-9.49 9.5-9.49 2.54 0 4.92.99 6.72 2.78a9.42 9.42 0 0 1 2.78 6.72c0 5.24-4.26 9.5-9.49 9.5zm8.08-17.58A11.4 11.4 0 0 0 12.04.5C5.76.5.65 5.61.65 11.89c0 2.02.53 3.99 1.53 5.73L.5 23.5l6.02-1.58a11.34 11.34 0 0 0 5.52 1.41h.01c6.28 0 11.39-5.11 11.39-11.39 0-3.04-1.18-5.9-3.33-8.05z"/></svg>';

/**
 * Mapa de iconos SVG de línea (24×24, stroke currentColor, stroke-width 1.4)
 * usados en credenciales, valores y beneficios. Se referencian por nombre
 * desde src/lib/home.ts y se inyectan con set:html.
 */
const iconos: Record<string, string> = {
  balanza:
    '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v18M8 21h8M5 7h14M5 7L3 12h4L5 7zM19 7l-2 5h4l-2-5z"/><path d="M5 12a2 2 0 0 0 4 0M15 12a2 2 0 0 0 4 0"/></svg>',
  llave:
    '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="4"/><path d="M11 11l9 9M17 17l2-2M14 14l2-2"/></svg>',
  pin:
    '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.6 7-11.5A7 7 0 0 0 5 9.5C5 14.4 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.3"/></svg>',
  globo:
    '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.6 4 6 4 9s-1.4 6.4-4 9c-2.6-2.6-4-6-4-9s1.4-6.4 4-9z"/></svg>',
  escudo:
    '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.7-7 9-4-1.3-7-4.5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>',
  ojo:
    '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>',
  brujula:
    '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M15 9l-2 6-6 2 2-6 6-2z"/></svg>',
  documento:
    '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4M9 12h6M9 16h6M9 8h2"/></svg>',
  maletin:
    '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="1.5"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18"/></svg>',
  sello:
    '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="5"/><path d="M9 13.5L7 21l5-2.5L17 21l-2-7.5"/></svg>',
  red:
    '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><path d="M6.6 7.2L11 16.4M17.4 7.2L13 16.4M7 6h10"/></svg>',
  lupa:
    '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.8-4.8"/></svg>',
  apreton:
    '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12l4-3 3 2 3-2 3 2 3-2 4 3"/><path d="M6 11l4 5 2-2 2 2 4-5"/></svg>',
};

// Icono "flecha" usado en el botón secundario del hero.
const iconoFlecha =
  '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1f1f1f" />
    <title>{seo.titulo}</title>
    <meta name="description" content={seo.descripcion} />
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph (WhatsApp / Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MAREA Group" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={seo.titulo} />
    <meta property="og:description" content={seo.descripcion} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.titulo} />
    <meta name="twitter:description" content={seo.descripcion} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="home">
    <!-- ── HEADER STICKY ───────────────────────────────── -->
    <header class="site-header" id="siteHeader">
      <div class="contenedor site-header__inner">
        <a href="#" class="site-header__logo" aria-label="Marea — volver al inicio">
          <img src={`${base}/logo-marea.png`} alt="Marea" width="720" height="405" />
        </a>

        <button
          class="menu-toggle"
          id="menuToggle"
          type="button"
          aria-expanded="false"
          aria-controls="siteNav"
          aria-label="Abrir menú"
        >
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18" />
          </svg>
        </button>

        <nav class="site-nav" id="siteNav" aria-label="Navegación principal">
          <ul class="site-nav__lista">
            {nav.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
          <a
            class="btn btn--mini site-nav__wa"
            href={waLink(contacto.numero, contacto.mensaje)}
            target="_blank"
            rel="noopener"
          >
            <span set:html={iconoWa} />
            WhatsApp
          </a>
        </nav>
      </div>
    </header>

    <main>
      <!-- ── HERO (único lugar con el video de mar) ───────── -->
      <section class="hero-seccion" id="inicio" aria-label={marca.titulo}>
        <MarFondo />
        <SonidoMar inline />

        <div class="contenedor hero-seccion__inner">
          <p class="kicker dorado reveal">{marca.kicker}</p>
          <h1 class="hero-seccion__titulo serif reveal">{marca.titulo}</h1>
          <p class="hero-seccion__bajada serif reveal" set:html={marca.bajada}></p>

          <div class="hero-seccion__botones reveal">
            <a class="btn btn--wa" href={waLink(contacto.numero, contacto.mensaje)} target="_blank" rel="noopener">
              <span set:html={iconoWa} />
              Hablemos por WhatsApp
            </a>
            <a class="btn btn--ghost-claro" href="#ecosistema">
              Conocé el ecosistema
              <span set:html={iconoFlecha} />
            </a>
          </div>
        </div>

        <div class="hero-seccion__logos reveal">
          <img class="logo-mecol" src={`${base}/logos/mecol-blanco.png`} alt="Mecol Estudio" loading="lazy" />
          <span class="hero-seccion__logos-div" aria-hidden="true"></span>
          <img class="logo-caetano" src={`${base}/logos/caetano-blanco.png`} alt="Caetano Negocios Inmobiliarios" loading="lazy" />
        </div>
      </section>

      <!-- ── FRANJA DE CREDENCIALES ────────────────────────── -->
      <section class="franja-credenciales reveal" aria-labelledby="credenciales-title">
        <h2 id="credenciales-title" class="sr-only">Marea en números</h2>
        <div class="contenedor credenciales-grid">
          {
            credenciales.map((c) => (
              <div class="credencial-item">
                <span class="credencial-item__icono" set:html={iconos[c.icono]} />
                <p>{c.texto}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- ── QUÉ ES MAREA ──────────────────────────────────── -->
      <section id="que-es" class="seccion-quees reveal" aria-labelledby="que-es-title">
        <div class="contenedor quees-grid">
          <div class="quees-texto">
            <p class="kicker">{marca.kicker}</p>
            <h2 id="que-es-title" class="titulo-seccion serif">Qué es {marca.titulo}</h2>
            <p class="parrafo serif" set:html={marca.bajada}></p>

            <ul class="valores-lista">
              {
                valores.map((v) => (
                  <li>
                    <span class="valores-lista__icono" set:html={iconos[v.icono]} />
                    <span class="valores-lista__texto">
                      <strong>{v.titulo}</strong>
                      <span>{v.texto}</span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="quees-imagen">
            <img
              src={`${base}${imagenQueEs.src}`}
              alt={imagenQueEs.alt}
              width="800"
              height="600"
              loading="lazy"
            />
          </div>
        </div>
      </section>

      <!-- ── EL ECOSISTEMA (franja clara) ───────────────────── -->
      <section id="ecosistema" class="seccion-ecosistema reveal" aria-labelledby="ecosistema-title">
        <div class="contenedor">
          <p class="kicker kicker--claro">El ecosistema</p>
          <h2 id="ecosistema-title" class="titulo-seccion titulo-seccion--claro serif">
            Las marcas que hoy forman parte de Marea
          </h2>

          <div class="marcas-grid">
            {
              marcas.map((m) => (
                <article class="marca-card-h">
                  <div class="marca-card-h__logo">
                    <img src={`${base}${m.logo}`} alt={m.nombre} loading="lazy" width="200" height="80" />
                  </div>
                  <div class="marca-card-h__body">
                    <h3 class="marca-card-h__nombre serif">{m.nombre}</h3>
                    <p class="marca-card-h__rubro">{m.rubro}</p>
                    <p class="marca-card-h__desc">{m.descripcion}</p>
                    <ul class="marca-card-h__servicios">
                      {m.servicios.map((s) => (
                        <li>
                          <span class="rombo-bullet rombo-bullet--claro" aria-hidden="true" />
                          {s}
                        </li>
                      ))}
                    </ul>
                    <div class="marca-card-h__botones">
                      <a
                        class="btn btn--mini btn--mini-claro"
                        href={waLink(m.wa, `¡Hola! Quiero conocer más sobre ${m.nombre}.`)}
                        target="_blank"
                        rel="noopener"
                        aria-label={`Escribir por WhatsApp a ${m.nombre}`}
                      >
                        <span set:html={iconoWa} />
                        WhatsApp
                      </a>
                      {
                        m.web && (
                          <a class="btn btn--mini btn--mini-claro btn--mini-ghost-claro" href={m.web} target="_blank" rel="noopener">
                            Sitio
                          </a>
                        )
                      }
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ── BENEFICIOS ─────────────────────────────────────── -->
      <section id="beneficios" class="seccion-beneficios reveal" aria-labelledby="beneficios-title">
        <div class="contenedor">
          <p class="kicker">Beneficios</p>
          <h2 id="beneficios-title" class="titulo-seccion serif">Para quién es Marea</h2>

          <div class="beneficios-grid-2col">
            {
              beneficios.map((b) => (
                <div class="beneficio-col">
                  <p class="kicker dorado">{b.publico}</p>
                  <h3 class="beneficio-col__titulo serif">{b.titulo}</h3>
                  <ul class="beneficio-col__lista">
                    {b.items.map((item) => (
                      <li>
                        <span class="beneficio-col__icono" set:html={iconos[item.icono]} />
                        <span>{item.texto}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ── PUNTA DEL ESTE (imagen full-bleed, parallax) ───── -->
      <section
        id="punta-del-este"
        class="seccion-pde reveal"
        aria-labelledby="pde-title"
        style={`background-image:url(${base}${puntaDelEste.imagen.src})`}
      >
        <span class="sr-only">{puntaDelEste.imagen.alt}</span>
        <div class="seccion-pde__overlay" aria-hidden="true"></div>
        <div class="contenedor seccion-pde__contenido">
          <p class="kicker dorado">{puntaDelEste.kicker}</p>
          <h2 id="pde-title" class="titulo-seccion serif">{puntaDelEste.titulo}</h2>
          <p class="seccion-pde__texto serif">{puntaDelEste.parrafo}</p>
        </div>
      </section>

      <!-- ── EQUIPO / OFICINAS ──────────────────────────────── -->
      <section id="equipo" class="seccion-equipo reveal" aria-labelledby="equipo-title">
        <div class="contenedor">
          <p class="kicker">{equipo.kicker}</p>
          <h2 id="equipo-title" class="titulo-seccion serif">{equipo.titulo}</h2>
          <p class="parrafo-corto">{equipo.parrafo}</p>

          <div class="equipo-grid">
            {
              equipo.fotos.map((f) => (
                <figure class="equipo-foto">
                  <img src={`${base}${f.src}`} alt={f.alt} loading="lazy" width="600" height="800" />
                  <figcaption>{f.pie}</figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ── EL LUGAR ───────────────────────────────────────── -->
      <section id="lugar" class="seccion-lugar reveal" aria-labelledby="lugar-title">
        <div class="contenedor lugar-grid">
          <div class="lugar-datos">
            <p class="kicker">Visitanos</p>
            <h2 id="lugar-title" class="titulo-seccion serif">El lugar</h2>
            <p class="lugar-datos__nombre serif">{lugar.nombre}</p>
            <p class="lugar-datos__dir">{lugar.direccion}</p>
            {lugar.horario && <p class="lugar-datos__horario">{lugar.horario}</p>}
            {
              lugar.mapsUrl && (
                <a class="btn btn--ghost" href={lugar.mapsUrl} target="_blank" rel="noopener">
                  Ver ubicación
                </a>
              )
            }
          </div>
          <div class="lugar-imagen">
            <img src={`${base}${lugar.imagen.src}`} alt={lugar.imagen.alt} loading="lazy" width="800" height="600" />
          </div>
        </div>
      </section>

      <!-- ── CTA FINAL (franja dorada) ──────────────────────── -->
      <section class="seccion-cta reveal" aria-labelledby="cta-title">
        <div class="contenedor">
          <h2 id="cta-title" class="titulo-seccion titulo-seccion--cta serif">Sumate a Marea</h2>
          <p class="seccion-cta__sub">
            Contanos qué necesitás y te ponemos en contacto con la marca indicada.
          </p>
          <a class="btn btn--carbon" href={waLink(contacto.numero, contacto.mensaje)} target="_blank" rel="noopener">
            <span set:html={iconoWa} />
            Escribinos por WhatsApp
          </a>
        </div>
      </section>

      <!-- ── BANDA INAUGURACIÓN ─────────────────────────────── -->
      <section class="banda reveal" aria-labelledby="banda-title">
        <div class="contenedor banda__inner">
          <p id="banda-title" class="banda__texto">
            Inauguramos el <span class="dorado">{inauguracion.fechaTexto}</span>
          </p>
          <a class="banda__link" href={`${base}${inauguracion.url}`}>Ver invitación →</a>
        </div>
      </section>
    </main>

    <!-- ── FOOTER ────────────────────────────────────────────── -->
    <footer class="site-footer">
      <div class="contenedor site-footer__grid">
        <div class="site-footer__marca">
          <img class="site-footer__logo" src={`${base}/logo-marea.png`} alt="Marea" width="720" height="405" />
          <p class="site-footer__firma">{footer.firma}</p>
        </div>

        <nav class="site-footer__nav" aria-label="Navegación del pie">
          <p class="site-footer__titulo">Navegación</p>
          <ul>
            {nav.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>

        <div class="site-footer__contacto">
          <p class="site-footer__titulo">Contacto</p>
          <a class="site-footer__wa" href={waLink(contacto.numero, contacto.mensaje)} target="_blank" rel="noopener">
            <span set:html={iconoWa} />
            WhatsApp
          </a>
          <p class="site-footer__dir">{footer.direccion}</p>
        </div>
      </div>

      <p class="site-footer__legal">© {anio} Marea. Todos los derechos reservados.</p>
    </footer>

    <script>
      // Reveal on scroll — respeta prefers-reduced-motion vía CSS.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Header sticky: se opaca al scrollear.
      const header = document.getElementById('siteHeader');
      const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 10);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // Menú mobile: botón hamburguesa accesible.
      const toggle = document.getElementById('menuToggle');
      const siteNav = document.getElementById('siteNav');
      toggle?.addEventListener('click', () => {
        const abierto = siteNav?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(!!abierto));
      });
      // Cerrar el menú al elegir una ancla (mobile).
      siteNav?.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => {
          siteNav.classList.remove('is-open');
          toggle?.setAttribute('aria-expanded', 'false');
        });
      });
    </script>

    <style>
      /* ═══ HOME · SECCIONES A ANCHO COMPLETO CON FONDOS ALTERNADOS ═══
         El body (global.css) trae fondo oscuro + grano fijo detrás de todo.
         Cada sección pinta su propio fondo y se posiciona con z-index:1
         para pintarse SIEMPRE por encima del grano fijo (que vive en
         z-index:0), sin necesidad de tocar global.css. */

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      /* Contenedor ancho propio de la home (más ancho que el .wrap de 620px
         que usa /invitacion). */
      .contenedor {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 1120px;
        margin-inline: auto;
        padding-inline: clamp(18px, 5vw, 40px);
      }

      main > section,
      .site-header,
      .site-footer {
        position: relative;
        z-index: 1;
      }

      /* ── HEADER STICKY ─────────────────────────────────── */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 40;
        background: rgba(22, 22, 22, 0.28);
        -webkit-backdrop-filter: blur(6px);
        backdrop-filter: blur(6px);
        border-bottom: 1px solid transparent;
        transition: background 0.3s ease, border-color 0.3s ease;
      }
      .site-header.is-scrolled {
        background: rgba(22, 22, 22, 0.86);
        border-bottom-color: var(--linea);
      }
      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-block: 0.7rem;
      }
      .site-header__logo img {
        height: clamp(30px, 7vw, 38px);
        width: auto;
        /* Logo negro → marfil, versión negativa sobre el header oscuro */
        filter: brightness(0) invert(1);
      }

      .menu-toggle {
        flex: none;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 10px;
        border: 1px solid var(--linea);
        background: transparent;
        color: var(--marfil);
        cursor: pointer;
      }
      .menu-toggle:focus-visible { outline: 2px solid var(--champagne); outline-offset: 2px; }

      .site-nav {
        position: fixed;
        inset: 62px 0 0 0;
        z-index: 39;
        display: none;
        flex-direction: column;
        gap: 0.4rem;
        padding: 1.2rem clamp(18px, 6vw, 40px) 2rem;
        background: rgba(22, 22, 22, 0.97);
        -webkit-backdrop-filter: blur(10px);
        backdrop-filter: blur(10px);
        overflow-y: auto;
      }
      .site-nav.is-open { display: flex; }
      .site-nav__lista {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
      }
      .site-nav__lista a {
        display: block;
        padding: 0.9rem 0.2rem;
        font-family: var(--sans);
        font-weight: 300;
        font-size: 1rem;
        letter-spacing: 0.06em;
        color: var(--marfil);
        border-bottom: 1px solid var(--linea);
        min-height: 44px;
      }
      .site-nav__wa {
        margin-top: 1rem;
        align-self: flex-start;
      }

      @media (min-width: 860px) {
        .menu-toggle { display: none; }
        .site-nav {
          position: static;
          display: flex;
          flex-direction: row;
          align-items: center;
          gap: clamp(1.2rem, 3vw, 2.2rem);
          padding: 0;
          background: transparent;
          backdrop-filter: none;
          -webkit-backdrop-filter: none;
          overflow: visible;
        }
        .site-nav__lista {
          flex-direction: row;
          gap: clamp(1rem, 2.4vw, 1.8rem);
        }
        .site-nav__lista a {
          padding: 0.4rem 0.1rem;
          font-size: 0.86rem;
          border-bottom: none;
          min-height: auto;
          position: relative;
        }
        .site-nav__lista a:hover { color: var(--champagne); }
        .site-nav__wa { margin-top: 0; }
      }

      /* ── BOTONES (compartidos con el resto de la página) ─ */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        font-family: var(--sans);
        font-weight: 400;
        font-size: clamp(0.88rem, 3.6vw, 1rem);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: clamp(0.85rem, 4vw, 1.05rem) clamp(1.6rem, 7vw, 2.2rem);
        border-radius: 999px;
        min-height: 44px;
        transition: transform 0.25s ease, background 0.25s ease, box-shadow 0.25s ease, color 0.25s ease;
        cursor: pointer;
      }
      .btn:active { transform: scale(0.97); }
      .btn:focus-visible { outline: 2px solid var(--champagne); outline-offset: 2px; }
      .btn--wa {
        border: none;
        color: var(--carbon);
        background: linear-gradient(135deg, var(--champagne), #dcc08c);
        box-shadow: 0 10px 30px -10px rgba(199, 164, 106, 0.6);
        font-weight: 500;
      }
      .btn--wa:hover { transform: translateY(-2px); box-shadow: 0 16px 38px -12px rgba(199, 164, 106, 0.7); }
      .btn--ghost {
        border: 1px solid var(--linea-dorada);
        color: var(--champagne);
        background: transparent;
      }
      .btn--ghost:hover { background: rgba(199, 164, 106, 0.08); }
      .btn--ghost-claro {
        border: 1px solid rgba(245, 243, 238, 0.55);
        color: var(--marfil);
        background: rgba(245, 243, 238, 0.06);
      }
      .btn--ghost-claro:hover { background: rgba(245, 243, 238, 0.16); }
      .btn--carbon {
        border: none;
        color: var(--marfil);
        background: var(--carbon);
        font-weight: 500;
      }
      .btn--carbon:hover { transform: translateY(-2px); box-shadow: 0 14px 32px -14px rgba(0, 0, 0, 0.5); }
      .btn--mini {
        padding: 0.6rem 1.1rem;
        font-size: 0.74rem;
        letter-spacing: 0.08em;
        min-height: 40px;
        border: 1px solid var(--linea-dorada);
        color: var(--champagne);
        background: rgba(199, 164, 106, 0.06);
      }
      .btn--mini:hover { background: rgba(199, 164, 106, 0.14); }
      .btn--mini-ghost {
        border-color: var(--linea);
        color: var(--piedra);
        background: transparent;
      }
      .btn--mini-claro { border-color: var(--nogal); color: var(--nogal); background: rgba(106, 78, 59, 0.06); }
      .btn--mini-claro:hover { background: rgba(106, 78, 59, 0.14); }
      .btn--mini-ghost-claro { border-color: rgba(31, 31, 31, 0.25); color: var(--carbon); background: transparent; }
      .btn--mini-ghost-claro:hover { background: rgba(31, 31, 31, 0.06); }

      /* ── TÍTULOS GENÉRICOS DE SECCIÓN ─────────────────────── */
      .titulo-seccion {
        font-family: var(--serif);
        font-weight: 500;
        font-size: clamp(1.7rem, 6vw, 2.6rem);
        line-height: 1.2;
        margin: 0.5rem 0 0.9rem;
        color: var(--marfil);
        max-width: 20ch;
      }
      .titulo-seccion--claro { color: var(--carbon); }
      .titulo-seccion--cta { color: var(--carbon); max-width: none; }
      .kicker--claro { color: var(--nogal); }

      /* ── HERO ──────────────────────────────────────────── */
      .hero-seccion {
        position: relative;
        overflow: hidden;
        /* transform crea "containing block" propio: el <MarFondo/> (position:
           fixed) queda confinado a esta sección en vez de a todo el viewport,
           así el video de mar solo se ve acá, como pide el rediseño. */
        transform: translateZ(0);
        min-height: 88dvh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding-block: clamp(90px, 18vh, 140px) clamp(2rem, 6vh, 3rem);
      }
      .hero-seccion__inner {
        text-align: left;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        max-width: 640px;
      }
      .hero-seccion__titulo {
        font-weight: 500;
        font-size: clamp(2.6rem, 12vw, 4.6rem);
        line-height: 1.02;
        color: var(--marfil);
        margin: 0.2rem 0 0.4rem;
      }
      .hero-seccion__bajada {
        font-size: clamp(1.05rem, 4.4vw, 1.3rem);
        font-weight: 400;
        line-height: 1.6;
        color: var(--marfil);
        max-width: 42ch;
        margin: 0;
      }
      .hero-seccion__bajada :global(strong) { font-weight: 600; color: #ffffff; }
      .hero-seccion__botones {
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem;
        margin-top: 0.8rem;
      }
      .hero-seccion__logos {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: clamp(1rem, 4vw, 1.8rem);
        padding: clamp(1.4rem, 5vh, 2rem) clamp(18px, 5vw, 40px) 0;
      }
      .hero-seccion__logos img { height: clamp(22px, 6vw, 30px); width: auto; opacity: 0.85; }
      .hero-seccion__logos img.logo-mecol { height: clamp(18px, 5vw, 24px); }
      .hero-seccion__logos-div { width: 1px; height: clamp(22px, 6vw, 30px); background: var(--linea); }

      /* ── FRANJA DE CREDENCIALES ────────────────────────── */
      .franja-credenciales { background: var(--carbon-2); padding-block: clamp(1.6rem, 5vw, 2.4rem); }
      .credenciales-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: clamp(1.2rem, 4vw, 1.8rem);
      }
      @media (min-width: 720px) { .credenciales-grid { grid-template-columns: repeat(4, 1fr); } }
      .credencial-item { display: flex; flex-direction: column; align-items: flex-start; gap: 0.5rem; }
      .credencial-item__icono { color: var(--champagne); }
      .credencial-item p {
        margin: 0;
        font-family: var(--sans);
        font-weight: 300;
        font-size: clamp(0.8rem, 3.4vw, 0.9rem);
        line-height: 1.4;
        color: var(--piedra);
      }

      /* ── QUÉ ES MAREA ───────────────────────────────────── */
      .seccion-quees { background: var(--carbon); padding-block: clamp(3rem, 9vw, 5.5rem); }
      .quees-grid { display: grid; grid-template-columns: 1fr; gap: clamp(2rem, 6vw, 3rem); align-items: center; }
      @media (min-width: 860px) { .quees-grid { grid-template-columns: 1.05fr 0.95fr; } }
      .parrafo {
        font-size: clamp(1.02rem, 4.2vw, 1.18rem);
        line-height: 1.65;
        color: var(--marfil);
        max-width: 46ch;
      }
      .parrafo :global(strong) { font-weight: 600; color: #ffffff; }
      .parrafo-corto {
        font-family: var(--sans);
        font-weight: 300;
        color: var(--piedra);
        max-width: 60ch;
        margin: 0.4rem 0 0;
      }
      .valores-lista { list-style: none; margin: 1.8rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 1.1rem; }
      .valores-lista li { display: flex; align-items: flex-start; gap: 0.9rem; }
      .valores-lista__icono { flex: none; color: var(--champagne); margin-top: 0.1rem; }
      .valores-lista__texto { display: flex; flex-direction: column; gap: 0.15rem; }
      .valores-lista__texto strong {
        font-family: var(--serif);
        font-style: italic;
        font-weight: 500;
        font-size: clamp(1rem, 4vw, 1.1rem);
        color: var(--marfil);
      }
      .valores-lista__texto span:last-child {
        font-family: var(--sans);
        font-weight: 300;
        font-size: 0.86rem;
        color: var(--piedra);
        line-height: 1.5;
      }
      .quees-imagen {
        position: relative;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid var(--linea);
      }
      .quees-imagen::after {
        /* Detalle dorado: barra desplazada en el borde de la imagen */
        content: '';
        position: absolute;
        left: -10px;
        top: 14%;
        bottom: 14%;
        width: 4px;
        background: linear-gradient(180deg, transparent, var(--champagne), transparent);
      }
      .quees-imagen img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }

      /* ── ECOSISTEMA (franja clara) ──────────────────────── */
      .seccion-ecosistema { background: var(--marfil); color: var(--carbon); padding-block: clamp(3rem, 9vw, 5.5rem); }
      .marcas-grid { display: grid; grid-template-columns: 1fr; gap: clamp(1.2rem, 4vw, 1.6rem); margin-top: 1.6rem; }
      @media (min-width: 760px) { .marcas-grid { grid-template-columns: repeat(2, 1fr); } }
      .marca-card-h {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: clamp(1.4rem, 5vw, 1.9rem);
        border: 1px solid rgba(31, 31, 31, 0.14);
        border-radius: 16px;
        background: rgba(31, 31, 31, 0.02);
      }
      @media (min-width: 560px) {
        .marca-card-h { flex-direction: row; align-items: flex-start; }
      }
      .marca-card-h__logo {
        flex: none;
        display: flex;
        align-items: center;
        justify-content: center;
        width: clamp(96px, 26vw, 120px);
        height: clamp(56px, 16vw, 68px);
      }
      .marca-card-h__logo img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        /* Logos vienen en blanco → los pasamos a negro para leerse sobre marfil */
        filter: brightness(0);
        opacity: 0.85;
      }
      .marca-card-h__body { flex: 1 1 auto; display: flex; flex-direction: column; gap: 0.35rem; }
      .marca-card-h__nombre { font-weight: 500; font-size: clamp(1.15rem, 4.6vw, 1.35rem); margin: 0; color: var(--carbon); }
      .marca-card-h__rubro {
        font-family: var(--sans);
        font-weight: 400;
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--nogal);
        margin: 0;
      }
      .marca-card-h__desc {
        font-family: var(--sans);
        font-weight: 300;
        font-size: 0.9rem;
        line-height: 1.55;
        color: #4a4844;
        margin: 0.2rem 0 0.1rem;
      }
      .marca-card-h__servicios { list-style: none; margin: 0.2rem 0 0.4rem; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
      .marca-card-h__servicios li {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        font-family: var(--sans);
        font-weight: 300;
        font-size: 0.84rem;
        color: #4a4844;
      }
      .rombo-bullet { flex: none; width: 6px; height: 6px; margin-top: 0.5em; transform: rotate(45deg); background: var(--champagne); }
      .rombo-bullet--claro { background: var(--nogal); }
      .marca-card-h__botones { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.4rem; }

      /* ── BENEFICIOS ─────────────────────────────────────── */
      .seccion-beneficios {
        background: linear-gradient(180deg, var(--carbon) 0%, #23261f 100%);
        padding-block: clamp(3rem, 9vw, 5.5rem);
      }
      .beneficios-grid-2col { display: grid; grid-template-columns: 1fr; gap: clamp(2rem, 6vw, 3rem); margin-top: 1.6rem; }
      @media (min-width: 760px) { .beneficios-grid-2col { grid-template-columns: repeat(2, 1fr); } }
      .beneficio-col__titulo { font-weight: 500; font-style: italic; font-size: clamp(1.25rem, 5vw, 1.55rem); color: var(--marfil); margin: 0.4rem 0 1rem; }
      .beneficio-col__lista { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.9rem; }
      .beneficio-col__lista li { display: flex; align-items: flex-start; gap: 0.8rem; }
      .beneficio-col__icono { flex: none; color: var(--champagne); margin-top: 0.05rem; }
      .beneficio-col__lista li span:last-child {
        font-family: var(--sans);
        font-weight: 300;
        font-size: clamp(0.86rem, 3.6vw, 0.95rem);
        line-height: 1.55;
        color: var(--piedra);
      }

      /* ── PUNTA DEL ESTE ─────────────────────────────────── */
      .seccion-pde {
        position: relative;
        min-height: 62vh;
        display: flex;
        align-items: center;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        /* Parallax suave en desktop; en iOS/mobile "fixed" rompe, por eso scroll */
        background-attachment: scroll;
      }
      @media (min-width: 860px) {
        .seccion-pde { background-attachment: fixed; }
      }
      .seccion-pde__overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(100deg, rgba(15, 14, 12, 0.82) 0%, rgba(15, 14, 12, 0.55) 55%, rgba(15, 14, 12, 0.35) 100%);
      }
      .seccion-pde__contenido { position: relative; z-index: 1; padding-block: clamp(3rem, 9vw, 4.5rem); max-width: 640px; }
      .seccion-pde__texto {
        font-size: clamp(1.02rem, 4.2vw, 1.2rem);
        line-height: 1.65;
        color: var(--marfil);
        max-width: 48ch;
        margin: 0.4rem 0 0;
      }

      /* ── EQUIPO / OFICINAS ──────────────────────────────── */
      .seccion-equipo { background: var(--carbon-2); padding-block: clamp(3rem, 9vw, 5.5rem); }
      .equipo-grid { display: grid; grid-template-columns: 1fr; gap: clamp(1rem, 4vw, 1.4rem); margin-top: 1.8rem; }
      @media (min-width: 640px) { .equipo-grid { grid-template-columns: repeat(3, 1fr); } }
      .equipo-foto { margin: 0; border-radius: 14px; overflow: hidden; border: 1px solid var(--linea); }
      /* Misma proporción en las tres para que la fila quede pareja;
         las fotos reales se recortan solas con object-fit: cover. */
      .equipo-foto img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
      .equipo-foto figcaption {
        padding: 0.6rem 0.9rem;
        font-family: var(--sans);
        font-weight: 300;
        font-size: 0.78rem;
        letter-spacing: 0.06em;
        color: var(--piedra);
        border-top: 1px solid var(--linea);
      }

      /* ── EL LUGAR ───────────────────────────────────────── */
      .seccion-lugar { background: var(--carbon); padding-block: clamp(3rem, 9vw, 5.5rem); }
      .lugar-grid { display: grid; grid-template-columns: 1fr; gap: clamp(2rem, 6vw, 3rem); align-items: center; }
      @media (min-width: 860px) { .lugar-grid { grid-template-columns: 0.95fr 1.05fr; } }
      .lugar-datos__nombre { font-size: clamp(1.25rem, 5vw, 1.55rem); font-style: italic; font-weight: 500; color: var(--marfil); margin: 0.8rem 0 0.3rem; }
      .lugar-datos__dir { font-family: var(--sans); font-weight: 300; letter-spacing: 0.03em; color: var(--piedra); margin: 0 0 0.3rem; }
      .lugar-datos__horario { font-family: var(--sans); font-weight: 300; font-size: 0.86rem; color: var(--piedra); margin: 0 0 1.4rem; }
      .lugar-imagen { border-radius: 18px; overflow: hidden; border: 1px solid var(--linea); }
      .lugar-imagen img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }

      /* ── CTA FINAL (franja dorada, mayor contraste) ─────── */
      .seccion-cta {
        background: linear-gradient(135deg, var(--champagne), #dcc08c);
        padding-block: clamp(3rem, 9vw, 4.5rem);
        text-align: center;
      }
      .seccion-cta .contenedor { max-width: 720px; display: flex; flex-direction: column; align-items: center; }
      .seccion-cta__sub {
        font-family: var(--sans);
        font-weight: 400;
        font-size: clamp(0.92rem, 3.8vw, 1.05rem);
        color: rgba(31, 31, 31, 0.82);
        max-width: 44ch;
        margin: 0 0 1.6rem;
      }

      /* ── BANDA INAUGURACIÓN ─────────────────────────────── */
      .banda { background: var(--carbon-2); padding-block: clamp(1rem, 3.6vw, 1.4rem); }
      .banda__inner { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; text-align: center; }
      .banda__texto { font-family: var(--sans); font-weight: 300; font-size: clamp(0.82rem, 3.6vw, 0.94rem); letter-spacing: 0.03em; color: var(--piedra); margin: 0; }
      .banda__link { font-family: var(--sans); font-weight: 400; font-size: clamp(0.78rem, 3.4vw, 0.88rem); letter-spacing: 0.1em; text-transform: uppercase; color: var(--champagne); padding: 0.3rem 0.2rem; min-height: 44px; display: inline-flex; align-items: center; }
      .banda__link:hover { text-decoration: underline; }

      /* ── FOOTER ─────────────────────────────────────────── */
      .site-footer { background: var(--carbon-2); padding-block: clamp(2.4rem, 7vw, 3.4rem) clamp(1.4rem, 4vw, 2rem); }
      .site-footer__grid { display: grid; grid-template-columns: 1fr; gap: clamp(1.8rem, 6vw, 2.6rem); }
      @media (min-width: 760px) { .site-footer__grid { grid-template-columns: 1.2fr 1fr 1fr; } }
      .site-footer__logo { height: 44px; width: auto; filter: brightness(0) invert(1); opacity: 0.9; }
      .site-footer__firma { margin-top: 0.8rem; font-family: var(--sans); font-weight: 300; font-size: 0.74rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--piedra); }
      .site-footer__titulo { font-family: var(--sans); font-weight: 400; font-size: 0.76rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--champagne); margin: 0 0 0.9rem; }
      .site-footer__nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
      .site-footer__nav a { font-family: var(--sans); font-weight: 300; font-size: 0.9rem; color: var(--marfil); }
      .site-footer__nav a:hover { color: var(--champagne); }
      .site-footer__contacto { display: flex; flex-direction: column; align-items: flex-start; gap: 0.8rem; }
