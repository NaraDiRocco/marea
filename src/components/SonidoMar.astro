---
/*
 * SonidoMar.astro — "Ruido de mar" generado con Web Audio (ruido filtrado +
 * swell tipo olas). Sin archivos ni licencias.
 *
 * Arranca ACTIVADO por defecto, pero como los navegadores bloquean el audio
 * automático (Safari incluido), el sonido empieza en la PRIMERA interacción
 * del usuario (toque/click/tecla). El botón permite silenciarlo.
 *
 * Prop `inline`: si es true, el botón se posiciona ABSOLUTE dentro de su
 * contenedor (la tarjeta glass) en vez de FIXED a la ventana.
 */
const { inline = false } = Astro.props;
---

<button
  class:list={['sonido', 'is-on', { 'sonido--inline': inline }]}
  id="btnSonido"
  type="button"
  aria-pressed="true"
  aria-label="Silenciar sonido de mar"
>
  <svg class="sonido__icon" viewBox="0 0 24 24" width="20" height="20" fill="none"
       stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 9.5v5h3.3L12 18V6L7.3 9.5H4z" fill="currentColor" stroke="none" />
    <path class="sonido__wave sonido__wave--1" d="M15 9.3a4 4 0 0 1 0 5.4" />
    <path class="sonido__wave sonido__wave--2" d="M17.6 7a7.2 7.2 0 0 1 0 10" />
  </svg>
  <span class="sonido__slash" aria-hidden="true"></span>
</button>

<script>
  const btn = document.getElementById('btnSonido');
  let ctx = null;
  let master = null;
  let started = false;
  let desiredOn = true; // arranca "activado"; suena en el primer gesto

  function build() {
    const AC = window.AudioContext || window.webkitAudioContext;
    ctx = new AC();

    const dur = 3;
    const buf = ctx.createBuffer(1, ctx.sampleRate * dur, ctx.sampleRate);
    const data = buf.getChannelData(0);
    let last = 0;
    for (let i = 0; i < data.length; i++) {
      const white = Math.random() * 2 - 1;
      last = (last + 0.02 * white) / 1.02;
      data[i] = last * 3.2;
    }
    const noise = ctx.createBufferSource();
    noise.buffer = buf;
    noise.loop = true;

    const hp = ctx.createBiquadFilter();
    hp.type = 'highpass';
    hp.frequency.value = 110;
    const lp = ctx.createBiquadFilter();
    lp.type = 'lowpass';
    lp.frequency.value = 720;
    lp.Q.value = 0.6;

    const swell = ctx.createGain();
    swell.gain.value = 0.55;
    const lfo = ctx.createOscillator();
    lfo.frequency.value = 0.11;
    const lfoDepth = ctx.createGain();
    lfoDepth.gain.value = 0.4;
    lfo.connect(lfoDepth).connect(swell.gain);

    const lfo2 = ctx.createOscillator();
    lfo2.frequency.value = 0.037;
    const lfo2Depth = ctx.createGain();
    lfo2Depth.gain.value = 0.12;
    lfo2.connect(lfo2Depth).connect(swell.gain);

    master = ctx.createGain();
    master.gain.value = 0;

    noise.connect(hp).connect(lp).connect(swell).connect(master).connect(ctx.destination);
    noise.start();
    lfo.start();
    lfo2.start();
    started = true;
  }

  function fade(to) {
    const now = ctx.currentTime;
    master.gain.cancelScheduledValues(now);
    master.gain.setValueAtTime(master.gain.value, now);
    master.gain.setTargetAtTime(to, now, 0.7);
  }

  function reflect() {
    btn.classList.toggle('is-on', desiredOn);
    btn.setAttribute('aria-pressed', String(desiredOn));
    btn.setAttribute('aria-label', desiredOn ? 'Silenciar sonido de mar' : 'Activar sonido de mar');
    btn.dataset.audio = started && ctx ? ctx.state : 'none';
  }

  // Sincroniza el audio con la intención. DEBE llamarse dentro de un gesto
  // del usuario para que el navegador permita el sonido (Safari incluido).
  function apply() {
    if (desiredOn) {
      if (!started) build();
      if (ctx.state !== 'running') ctx.resume(); // sincrónico: clave para Safari
      if (ctx.state === 'running') fade(0.32);
    } else if (started) {
      fade(0);
    }
    reflect();
  }

  // El audio automático está bloqueado: arrancamos en la primera interacción.
  const gestures = ['pointerdown', 'touchend', 'click', 'keydown'];
  function kick(e) {
    const t = e && e.target;
    if (t && t.closest && t.closest('#btnSonido')) return; // el botón se maneja solo
    gestures.forEach((ev) => window.removeEventListener(ev, kick));
    apply();
  }
  gestures.forEach((ev) => window.addEventListener(ev, kick, { passive: true }));

  // Botón: activar / silenciar manualmente
  btn.addEventListener('click', () => {
    gestures.forEach((ev) => window.removeEventListener(ev, kick));
    desiredOn = !desiredOn;
    apply();
  });

  reflect(); // estado visual inicial (activado)
</script>

<style>
  .sonido {
    position: fixed;
    top: clamp(1rem, 3vw, 1.6rem);
    right: clamp(1rem, 3vw, 1.6rem);
    z-index: 20;
    width: clamp(40px, 10vw, 46px);
    height: clamp(40px, 10vw, 46px);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(245, 243, 238, 0.3);
    background: rgba(31, 31, 31, 0.4);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: var(--marfil);
    cursor: pointer;
    transition: color 0.3s ease, border-color 0.3s ease, background 0.3s ease, transform 0.2s ease;
  }
  .sonido--inline {
    position: absolute;
    top: clamp(0.9rem, 3.5vw, 1.3rem);
    right: clamp(0.9rem, 3.5vw, 1.3rem);
    background: rgba(245, 243, 238, 0.06);
  }
  .sonido:hover { border-color: var(--champagne); color: var(--marfil); }
  .sonido:active { transform: scale(0.94); }
  .sonido.is-on { color: var(--marfil); border-color: rgba(245, 243, 238, 0.55); }

  .sonido__icon { display: block; }
  .sonido__wave { opacity: 0; transition: opacity 0.3s ease; }
  .sonido.is-on .sonido__wave { opacity: 1; }
  .sonido.is-on .sonido__wave--1 { animation: son-late 2.2s ease-in-out infinite; }
  .sonido.is-on .sonido__wave--2 { animation: son-late 2.2s ease-in-out infinite 0.3s; }

  .sonido__slash {
    position: absolute;
    width: 24px;
    height: 1.4px;
    background: currentColor;
    transform: rotate(-45deg);
    transition: opacity 0.3s ease;
    opacity: 0.8;
  }
  .sonido.is-on .sonido__slash { opacity: 0; }

  @keyframes son-late {
    0%, 100% { opacity: 0.5; }
    50%      { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sonido.is-on .sonido__wave { animation: none; }
  }
</style>
