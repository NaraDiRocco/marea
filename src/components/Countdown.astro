---
/**
 * Countdown elegante hacia la fecha del evento.
 * Recibe la fecha ISO por prop; el conteo se calcula en el cliente.
 */
interface Props {
  fechaISO: string;
}
const { fechaISO } = Astro.props;
---

<div class="countdown" data-target={fechaISO} aria-label="Cuenta regresiva para el evento">
  <div class="cd__unit">
    <span class="cd__num" data-dias>--</span>
    <span class="cd__label">Días</span>
  </div>
  <span class="cd__sep">:</span>
  <div class="cd__unit">
    <span class="cd__num" data-horas>--</span>
    <span class="cd__label">Horas</span>
  </div>
  <span class="cd__sep">:</span>
  <div class="cd__unit">
    <span class="cd__num" data-min>--</span>
    <span class="cd__label">Min</span>
  </div>
  <span class="cd__sep">:</span>
  <div class="cd__unit">
    <span class="cd__num" data-seg>--</span>
    <span class="cd__label">Seg</span>
  </div>
</div>

<p class="cd__llego" data-llego hidden>El momento llegó · ¡Te esperamos!</p>

<style>
  .countdown {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(0.35rem, 2vw, 0.9rem);
    margin-inline: auto;
  }
  .cd__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: clamp(46px, 15vw, 66px);
    padding: clamp(0.45rem, 2.2vw, 0.75rem) 0.25rem;
    border: 1px solid var(--linea);
    border-radius: 4px;
    background: linear-gradient(180deg, rgba(245, 243, 238, 0.04), rgba(245, 243, 238, 0.01));
    backdrop-filter: blur(2px);
  }
  .cd__num {
    font-family: var(--serif);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    font-size: clamp(1.5rem, 8vw, 2.2rem);
    line-height: 1;
    color: var(--marfil);
  }
  .cd__label {
    margin-top: 0.4rem;
    font-family: var(--sans);
    font-weight: 300;
    font-size: clamp(0.5rem, 2.3vw, 0.64rem);
    letter-spacing: 0.24em;
    text-indent: 0.24em;
    text-transform: uppercase;
    color: var(--piedra);
  }
  .cd__sep {
    font-family: var(--serif);
    font-size: clamp(1.2rem, 6vw, 1.8rem);
    line-height: clamp(46px, 15vw, 66px);
    color: var(--champagne);
    opacity: 0.7;
  }
  .cd__llego {
    text-align: center;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.3rem, 6vw, 1.8rem);
    color: var(--champagne);
    margin: 0;
  }
</style>

<script>
  function initCountdown() {
    const el = document.querySelector<HTMLElement>('.countdown');
    if (!el) return;
    const target = new Date(el.dataset.target!).getTime();
    const dias = el.querySelector('[data-dias]')!;
    const horas = el.querySelector('[data-horas]')!;
    const min = el.querySelector('[data-min]')!;
    const seg = el.querySelector('[data-seg]')!;
    const llego = document.querySelector<HTMLElement>('[data-llego]');

    const pad = (n: number) => String(n).padStart(2, '0');

    function tick() {
      const diff = target - Date.now();
      if (diff <= 0) {
        el!.style.display = 'none';
        if (llego) llego.hidden = false;
        clearInterval(timer);
        return;
      }
      const d = Math.floor(diff / 86400000);
      const h = Math.floor((diff % 86400000) / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);
      dias.textContent = String(d);
      horas.textContent = pad(h);
      min.textContent = pad(m);
      seg.textContent = pad(s);
    }

    tick();
    const timer = setInterval(tick, 1000);
  }

  initCountdown();
  // Re-inicializar en navegación de Astro View Transitions (si se activa)
  document.addEventListener('astro:page-load', initCountdown);
</script>
